pipeline {
    agent any

    environment {
        REGISTRY = "docker.io"
        IMAGE_NAME = "nexvion-ecommerce"
        TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Security Scan') {
            steps {
                echo "Running security and dependency scans..."
            }
        }

        stage('Docker Build & Scan') {
            steps {
                echo "Building Docker image..."
                sh "docker build -t ${env.REGISTRY}/${env.IMAGE_NAME}:${env.TAG} -f docker/Dockerfile ."
            }
        }

        stage('Deploy to Docker') {
            steps {
                echo "Deploying application to Docker..."
                sh "docker stop docker-nexvion-app-1 || true"
                sh "docker rm docker-nexvion-app-1 || true"
                sh "docker run -d --name docker-nexvion-app-1 -p 8090:80 ${env.REGISTRY}/${env.IMAGE_NAME}:${env.TAG}"
            }
        }
    }
}